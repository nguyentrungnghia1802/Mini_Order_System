# Local/demo placeholders only. Use generated secrets for any shared deployment.
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=change-me-before-use
POSTGRES_ADMIN_DB=postgres

PRODUCT_DB_NAME=microshop_product
PRODUCT_DB_USER=product_app
PRODUCT_DB_PASSWORD=change-me-product
# Product Service native runtime overrides (the password remains local only).
PRODUCT_DB_HOST=localhost
PRODUCT_DB_PORT=5432

ORDER_DB_NAME=microshop_order
ORDER_DB_USER=order_app
ORDER_DB_PASSWORD=change-me-order
# Order Service native runtime overrides (the password remains local only).
ORDER_DB_HOST=localhost
ORDER_DB_PORT=5432

NOTIFICATION_DB_NAME=microshop_notification
NOTIFICATION_DB_USER=notification_app
NOTIFICATION_DB_PASSWORD=change-me-notification
NOTIFICATION_DB_HOST=localhost
NOTIFICATION_DB_PORT=5432

RABBITMQ_USER=microshop
RABBITMQ_PASSWORD=change-me-rabbitmq
RABBITMQ_HOST=localhost
RABBITMQ_VHOST=/
RABBITMQ_PORT=5672
RABBITMQ_USE_IN_MEMORY=false

PRODUCT_SERVICE_URL=http://product-service:8080
ORDER_SERVICE_URL=http://order-service:8080
NOTIFICATION_SERVICE_URL=http://notification-service:8080
ALLOWED_ORIGINS=http://localhost:4200,http://localhost:8080
